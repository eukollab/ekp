              "parameters": [
                {
                  "name": "id",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "integer"
                  }
                },
                {
                  "name": "id",
                  "in": "query",
                  "schema": {
                    "type": "string"
                  }
                },
                {
                  "name": "body",
                  "in": "query",
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "requestBody": {
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/Note"
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/Note"
                      }
                    }
                  }
                }
              }
            }
          },
          "/count": {
            "get": {
              "operationId": "count",
              "x-eukollab-class": "transformation",
