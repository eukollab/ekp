{
  "description": "OpenAPI operations as tools (PROTOCOL.md §5.3). Every operation of an OpenAPI 3.0 or 3.1 document with a JSON request body (or none) and no required cookie becomes one tool, in document order (paths, then get, put, post, delete, patch, head). name: the operationId, else the method followed by the path, with each run of characters outside [A-Za-z0-9_.-] replaced by _ and trimmed of _. inputSchema: an object whose properties are the path, query and header parameters by name (a name used twice, or the name body, becomes <in>_<name>) and the JSON body under body; path parameters and required ones are required, and body when the request body is required. outputSchema: the lowest 2xx JSON response's schema when it is an object, else that schema under the required property result, else {status: integer} for a response without a JSON body. Local $refs are inlined (a reference back into itself becomes {}), nullable becomes a null type, and discriminator, xml, externalDocs and example are dropped. An integer schema with format int64 also takes its decimal string: its type gains string and the pattern ^-?[0-9]+$ (before nullable adds null). answers: an answer's integer beyond ±2^53, at any depth, is carried as its exact decimal string; an int64 body field given as such a string is sent as the number. annotations: x-eukollab-class when set, else readOnlyHint for get and head, else readOnlyHint false, with destructiveHint for delete and idempotentHint for put and delete.",
  "cases": [
    {
      "name": "parameters, a $ref'd body, an array and an empty response, and two operations that can't be called",
      "document": {
        "openapi": "3.1.0",
        "info": {
          "title": "Shipping",
          "version": "1"
        },
        "servers": [
          {
            "url": "https://api.ship.test/{version}",
            "variables": {
              "version": {
                "default": "v1"
              }
            }
          }
        ],
        "paths": {
          "/rates/{country}": {
            "parameters": [
              {
                "name": "country",
                "in": "path",
                "required": true,
                "schema": {
                  "type": "string"
                }
              }
            ],
            "get": {
              "operationId": "get_rate",
              "summary": "The rate to a country.",
              "parameters": [
                {
                  "name": "weight",
                  "in": "query",
                  "required": true,
                  "schema": {
                    "type": "number"
                  }
                },
                {
                  "name": "X-Region",
                  "in": "header",
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/Rate"
                      }
                    }
                  }
                }
              }
            }
          },
          "/labels": {
            "post": {
              "operationId": "create label",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/Label"
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "array"
                      }
                    }
                  }
                }
              }
            }
          },
          "/labels/{id}": {
            "delete": {
              "operationId": "delete_label",
              "parameters": [
                {
                  "name": "id",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "204": {
                  "description": "gone"
                }
              }
            }
          },
          "/upload": {
            "post": {
              "operationId": "upload",
              "requestBody": {
                "content": {
                  "multipart/form-data": {
                    "schema": {
                      "type": "object"
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "ok"
                }
              }
            }
          },
          "/session": {
            "get": {
              "operationId": "session",
              "parameters": [
                {
                  "name": "sid",
                  "in": "cookie",
                  "required": true,
                  "schema": {
                    "type": "string"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "ok"
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "Rate": {
              "type": "object",
              "properties": {
                "price": {
                  "type": "number"
                },
                "note": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "price"
              ]
            },
            "Label": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string"
                }
              },
              "required": [
                "to"
              ]
            }
          }
        }
      },
      "tools": [
        {
          "name": "get_rate",
          "description": "The rate to a country.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "country": {
                "type": "string"
              },
              "weight": {
                "type": "number"
              },
              "X-Region": {
                "type": "string"
              }
            },
            "required": [
