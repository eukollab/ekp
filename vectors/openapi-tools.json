    {
      "name": "int64: also its decimal string, so values beyond ±2^53 are carried exactly",
      "document": {
        "openapi": "3.0.3",
        "info": {
          "title": "Pets",
          "version": "1"
        },
        "paths": {
          "/pets/{petId}": {
            "get": {
              "operationId": "getPetById",
              "parameters": [
                {
                  "name": "petId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "integer",
                    "format": "int64"
                  }
                }
              ],
              "responses": {
                "200": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "format": "int64"
                          },
                          "owner": {
                            "type": "integer",
                            "format": "int64",
                            "nullable": true
                          },
                          "age": {
                            "type": "integer",
                            "format": "int32"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "tools": [
        {
          "name": "getPetById",
          "description": "GET /pets/{petId}",
          "inputSchema": {
            "type": "object",
            "properties": {
              "petId": {
                "type": [
                  "integer",
                  "string"
                ],
                "format": "int64",
                "pattern": "^-?[0-9]+$"
              }
            },
            "required": [
              "petId"
            ]
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "integer",
                  "string"
                ],
                "format": "int64",
                "pattern": "^-?[0-9]+$"
              },
              "owner": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ],
                "format": "int64",
                "pattern": "^-?[0-9]+$"
              },
              "age": {
                "type": "integer",
                "format": "int32"
              }
            }
          },
          "annotations": {
            "readOnlyHint": true
          }
        }
      ],
      "skipped": []
    }
