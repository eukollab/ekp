                    "application/json": {
                      "schema": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "Note": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "nullable": true,
                  "example": "hi"
                },
                "parent": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          }
