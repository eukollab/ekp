{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/3.8/events/connection.accepted.json",
  "title": "connection.accepted",
  "description": "The connection is active.",
  "type": "object",
  "properties": {
    "note": {
      "type": "string",
      "description": "Note.",
      "x-ekl-untrusted": true
    },
    "rel_ver": {
      "type": "integer",
      "description": "Relationship version."
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "For capabilities asked for on an active connection: the ones now added to its scope."
    }
  },
  "additionalProperties": false,
  "required": [
    "rel_ver"
  ],
  "examples": [
    {
      "note": "",
      "rel_ver": 2
    }
  ]
}
