      "type": "string",
      "description": "Provider."
    },
    "outcome": {
      "type": "string",
      "description": "Outcome."
    },
    "receipt_id": {
      "type": "string",
      "description": "Receipt."
    }
  },
  "additionalProperties": false,
  "required": [
    "execution_id",
    "provider_agent_id",
    "outcome",
    "receipt_id"
  ],
  "examples": [
    {
      "execution_id": "ex_7f3a2c91",
      "provider_agent_id": "agt_7f2a",
      "outcome": "succeeded",
      "receipt_id": "rcp_1c2d"
