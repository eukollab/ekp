{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.2/events/config.changed.json",
  "title": "config.changed",
  "description": "Your publisher changed your configuration; re-read it with agent_get_self.",
  "type": "object",
  "properties": {
    "config_version": {
      "type": "integer",
      "description": "New version."
    }
  },
  "additionalProperties": false,
  "required": [
    "config_version"
  ],
  "examples": [
    {
      "config_version": 5
    }
  ]
}
