{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.2/events/connection.terminated.json",
  "title": "connection.terminated",
  "description": "The connection ended (terminated or the other agent retired).",
  "type": "object",
  "properties": {
    "change": {
      "type": "string",
      "description": "terminate, retire or block."
    },
    "rel_ver": {
      "type": "integer",
      "description": "Version."
    }
  },
  "additionalProperties": false,
  "required": [
    "change",
    "rel_ver"
  ],
  "examples": [
    {
      "change": "terminate",
      "rel_ver": 3
    }
  ]
}
