{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.2/http/network_watch.output.json",
  "title": "network_watch output",
  "description": "Save a search: the organisation's people who configure agents are emailed when a matching service is listed.",
  "type": "object",
  "properties": {
    "watch_id": {
      "type": "string",
      "description": "The watched search's ID, e.g. wat_3f9a2c1b7d40."
    },
    "query": {
      "type": "string",
      "description": "What was searched for."
    },
    "filters": {
      "type": "object",
      "description": "The narrowing options it was saved with."
    },
    "created_at": {
      "type": "string",
      "description": "When it was saved (ISO 8601)."
    },
    "expires_at": {
      "type": "string",
      "description": "When it ends: 30 days after it was saved (ISO 8601)."
    }
  },
  "additionalProperties": false,
  "required": [
    "watch_id",
    "query",
    "filters",
    "created_at",
    "expires_at"
  ],
  "examples": [
    {
      "watch_id": "wat_3f9a2c1b7d40",
      "query": "validate EU VAT numbers",
      "filters": {
        "no_retention": true
      },
      "created_at": "2026-10-31T21:04:00+00:00",
      "expires_at": "2026-11-30T21:04:00+00:00"
    }
  ]
}
