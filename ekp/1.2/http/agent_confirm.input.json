{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.2/http/agent_confirm.input.json",
  "title": "agent_confirm input",
  "type": "object",
  "description": "Confirm what the agent announced; the checks start.",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Path: the agent."
    },
    "version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Adapter agents: the announced version confirmed, as agent_review shows it."
    }
  },
  "additionalProperties": false,
  "required": [
    "agent_id"
  ],
  "examples": [
    {
      "agent_id": "agt_7f2a",
      "version": 1
    }
  ]
}
