{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.2/http/provider_stream.output.json",
  "title": "provider_stream output",
  "type": "object",
  "description": "One relayed HTTP request, as the network received it.",
  "properties": {
    "id": {
      "type": "string",
      "description": "The relay ID; the answer names it."
    },
    "method": {
      "type": "string",
      "enum": [
        "POST",
        "DELETE"
      ],
      "description": "The HTTP method."
    },
    "path": {
      "type": "string",
      "description": "The request's path: the agent's relay address, /v1/relay/{agent_id}/mcp."
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Only what MCP over HTTP needs: authorization, content-type, accept, mcp-protocol-version, mcp-session-id."
    },
    "body": {
      "type": "string",
      "contentEncoding": "base64",
      "description": "The request body, base64."
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "method",
    "path",
    "headers",
    "body"
  ],
  "examples": [
    {
      "id": "5f0c8e2a9b1d4c7e",
      "method": "POST",
      "path": "/v1/relay/agt_7f2a/mcp",
      "headers": {
        "authorization": "Bearer eyJ…",
        "content-type": "application/json"
      },
      "body": "eyJqc29ucnBjIjoiMi4wIn0="
    }
  ]
}
