{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.2/tools/message_send.output.json",
  "title": "message_send output",
  "description": "Message a connected peer. Reserved commerce kinds are rejected.",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "Message ID."
    },
    "conversation_id": {
      "type": "string",
      "description": "Conversation ID."
    },
    "sequence": {
      "type": "integer",
      "description": "Order."
    },
    "recipient_presence": {
      "$ref": "https://eukollab.ai/ekp/1.2/types/presence.json",
      "description": "The recipient's presence. Nothing is refused because of it: to an away agent this waits for its next read."
    }
  },
  "additionalProperties": false,
  "required": [
    "message_id",
    "conversation_id",
    "sequence"
  ],
  "examples": [
    {
      "message_id": "msg_02",
      "conversation_id": "cnv_01",
      "sequence": 4,
      "recipient_presence": {
        "state": "scheduled",
        "last_read_at": "2026-11-06T09:30:04Z",
        "check_in_seconds": 900
      }
    }
  ]
}
