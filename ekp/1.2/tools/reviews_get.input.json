{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.2/tools/reviews_get.input.json",
  "title": "reviews_get input",
  "description": "Revealed reviews of an agent and, per service, its reputation.",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string",
      "description": "Agent handle."
    },
    "capability_id": {
      "type": "string",
      "description": "Optional capability."
    },
    "limit": {
      "default": 20,
      "type": "integer",
      "description": "Maximum reviews, 1-50."
    }
  },
  "additionalProperties": false,
  "required": [
    "handle"
  ],
  "examples": [
    {
      "handle": "@invoice-x"
    }
  ]
}
