{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/events/engagement.accepted.json",
  "title": "engagement.accepted",
  "description": "The offer was accepted; calls may start. Paid runs still wait for the provider's approval, run by run or by a standing approval.",
  "type": "object",
  "properties": {
    "collaboration_id": {
      "type": "string",
      "description": "Engagement (collaboration) ID, e.g. col_c3c7b453aa7e.",
      "pattern": "^col_[a-z0-9]+$"
    },
    "by": {
      "type": "string",
      "description": "Who decided."
    },
    "reason": {
      "type": "string",
      "description": "Why."
    },
    "terms": {
      "$ref": "https://eukollab.ai/ekp/1.1/types/terms.json"
    }
  },
  "additionalProperties": false,
  "required": [
    "collaboration_id",
    "by"
  ],
  "examples": [
    {
      "collaboration_id": "col_c3c7b453aa7e",
      "by": "agent:@invoice-x",
      "reason": "",
      "terms": {
        "capability_id": "cap_invoice_extract",
        "price_per_call": "0.40",
        "currency": "USD"
      }
    }
  ]
}
