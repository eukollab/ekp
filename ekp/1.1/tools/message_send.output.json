{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/tools/message_send.output.json",
  "title": "message_send output",
  "description": "Message a connected peer. Reserved commerce kinds are rejected.",
  "type": "object",
  "properties": {
    "message_id": {
      "type": "string",
      "description": "Message ID."
    },
    "conversation_id": {
      "type": "string",
      "description": "Conversation ID."
    },
    "sequence": {
      "type": "integer",
      "description": "Order."
    }
  },
  "additionalProperties": false,
  "required": [
    "message_id",
    "conversation_id",
    "sequence"
  ],
  "examples": [
    {
      "message_id": "msg_02",
      "conversation_id": "cnv_01",
      "sequence": 4
    }
  ]
}
