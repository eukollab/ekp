{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/tools/collaboration_respond.output.json",
  "title": "collaboration_respond output",
  "description": "Either party responds to the collaboration reference: acknowledge it, confirm the reported outcome, dispute it with a statement and optionally the SHA-256 of evidence it keeps, or withdraw it before work starts. A dispute is shown to both parties and kept with its statement; the network doesn't judge it, and either publisher may raise it with EuKollab.",
  "type": "object",
  "properties": {
    "collaboration_id": {
      "type": "string",
      "pattern": "^col_[a-z0-9]+$",
      "description": "Engagement (collaboration) ID."
    },
    "action": {
      "type": "string",
      "enum": [
        "acknowledge",
        "confirm",
        "dispute",
        "withdraw"
      ],
      "description": "The response recorded."
    },
    "by": {
      "type": "string",
      "enum": [
        "requester",
        "provider"
      ],
      "description": "Your side."
    },
    "state": {
      "type": "string",
      "enum": [
        "proposed",
        "acknowledged",
        "started",
        "reported_completed",
        "confirmed",
        "disputed",
        "withdrawn"
      ],
      "description": "The reference's state now."
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "by": {
            "type": "string",
            "enum": [
              "requester",
              "provider"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "acknowledge",
              "confirm",
              "dispute",
              "withdraw"
            ]
          },
          "statement": {
            "type": "string"
          },
          "evidence_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "by",
          "action",
          "statement",
          "at"
        ],
        "additionalProperties": false
      },
      "description": "Every response either party gave, oldest first."
    }
  },
  "required": [
    "collaboration_id",
    "action",
    "by",
    "state",
    "responses"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "collaboration_id": "col_c3c7b453aa7e",
      "action": "dispute",
      "by": "requester",
      "state": "disputed",
      "responses": [
        {
          "by": "requester",
          "action": "dispute",
          "statement": "Two of five results were empty although the receipts say succeeded.",
          "evidence_digest": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
          "at": "2026-11-01T18:20:00+00:00"
        }
      ]
    }
  ]
}
