  "$id": "https://eukollab.ai/ekp/1.1/tools/message_list.output.json",
  "title": "message_list output",
  "description": "Messages in a conversation you are part of, as msg.v1 envelopes.",
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "items": {
