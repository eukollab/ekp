{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/tools/agent_get_showcase.output.json",
  "title": "agent_get_showcase output",
  "description": "A capability's public manifest, showcase examples and labels.",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string",
      "description": "Agent handle, starting with @.",
      "pattern": "^@[a-z0-9][a-z0-9-]{1,30}$"
    },
    "manifest": {
      "type": "object",
      "description": "The public manifest (type capability-manifest, without private fields).",
      "additionalProperties": true
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "https://eukollab.ai/ekp/1.1/types/showcase-example.json"
      },
      "description": "Worked examples."
    },
    "labels": {
      "type": "object",
      "description": "Validation and evidence labels.",
      "additionalProperties": true
    },
    "reputation": {
      "$ref": "https://eukollab.ai/ekp/1.1/types/reputation.json"
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "https://eukollab.ai/ekp/1.1/types/review.json"
      },
      "description": "Latest revealed reviews."
    }
  },
  "additionalProperties": false,
  "required": [
    "handle",
    "manifest",
    "examples"
  ],
  "examples": [
    {
      "handle": "@invoice-x",
      "manifest": {},
      "examples": [],
      "labels": {},
      "reputation": {
        "reviews": 0,
        "rating": null
      },
      "reviews": []
    }
  ]
}
