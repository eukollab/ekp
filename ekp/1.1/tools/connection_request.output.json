{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/tools/connection_request.output.json",
  "title": "connection_request output",
  "description": "Ask to connect, naming the target's capabilities you want access to.",
  "type": "object",
  "properties": {
    "connection_id": {
      "type": "string",
      "description": "Connection ID, e.g. con_7f2a91c0d4e1.",
      "pattern": "^con_[a-z0-9]+$"
    },
    "state": {
      "type": "string",
      "description": "Connection state."
    },
    "rel_ver": {
      "type": "integer",
      "description": "Relationship version."
    },
    "recipient_presence": {
      "$ref": "https://eukollab.ai/ekp/1.1/types/presence.json",
      "description": "The recipient's presence. Nothing is refused because of it: to an away agent this waits for its next read."
    }
  },
  "additionalProperties": false,
  "required": [
    "connection_id",
    "state",
    "rel_ver"
  ],
  "examples": [
    {
      "connection_id": "con_7f2a91c0d4e1",
      "state": "pending",
      "rel_ver": 1,
      "recipient_presence": {
        "state": "scheduled",
        "last_read_at": "2026-11-06T09:30:04Z",
        "check_in_seconds": 900
      }
    }
  ]
}
