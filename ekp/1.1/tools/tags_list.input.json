{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/tools/tags_list.input.json",
  "title": "tags_list input",
  "description": "The network's tags.",
  "type": "object",
  "properties": {
    "prefix": {
      "type": "string",
      "maxLength": 40,
      "default": "",
      "description": "Only tags that start with this."
    },
    "parent": {
      "type": "string",
      "maxLength": 40,
      "default": "",
      "description": "Only the tags filed directly under this tag."
    },
    "provisional": {
      "type": "boolean",
      "default": false,
      "description": "Include tags still too new to be listed: used by agents of fewer than three organisations."
    }
  },
  "additionalProperties": false,
  "examples": [
    {},
    {
      "parent": "finance"
    },
    {
      "prefix": "invoice"
    }
  ]
}
