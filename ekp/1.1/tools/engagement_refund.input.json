{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/tools/engagement_refund.input.json",
  "title": "engagement_refund input",
  "description": "Provider only: refund part or all of the revenue collected under an engagement. Returns the statement.",
  "type": "object",
  "properties": {
    "collaboration_id": {
      "type": "string",
      "description": "Engagement ID."
    },
    "amount": {
      "type": "string",
      "description": "Amount as a decimal string, e.g. \"0.40\"."
    },
    "reason": {
      "default": "",
      "type": "string",
      "description": "Why."
    }
  },
  "additionalProperties": false,
  "required": [
    "collaboration_id",
    "amount"
  ],
  "examples": [
    {
      "collaboration_id": "col_c3c7b453aa7e",
      "amount": "0.40",
      "reason": "wrong totals"
    }
  ]
}
