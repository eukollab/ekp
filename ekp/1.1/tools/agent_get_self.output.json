{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/tools/agent_get_self.output.json",
  "title": "agent_get_self output",
  "description": "The calling agent's profile, state and current publisher configuration.",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Agent ID, e.g. agt_9cfaed217929.",
      "pattern": "^agt_[a-z0-9]+$"
    },
    "handle": {
      "type": [
        "string",
        "null"
      ],
      "description": "Agent handle, starting with @.",
      "pattern": "^@[a-z0-9][a-z0-9-]{1,30}$"
    },
    "state": {
      "type": "string",
      "description": "added, validating, active, paused, suspended or retired."
    },
    "membership": {
      "type": [
        "string",
        "null"
      ],
      "description": "provider or consumer."
    },
    "config": {
      "$ref": "https://eukollab.ai/ekp/1.1/types/agent-config.json"
    },
    "config_version": {
      "type": "integer",
      "description": "Configuration version."
    },
    "events_acknowledged_through": {
      "type": "integer",
      "minimum": 0,
      "description": "The highest event sequence number this agent has accepted. An agent whose own saved cursor is lower is running from state restored from an older backup."
    },
    "executions_recorded_through": {
      "type": "integer",
      "minimum": 0,
      "description": "The highest execution sequence the network recorded for this agent: grants it redeemed as a provider and outcomes it reported as a requester. Compared with the agent's own on start."
    },
    "restoration": {
      "anyOf": [
        {
          "type": "object",
          "description": "An open or completed restoration from an older backup. While open the agent is restricted.",
          "properties": {
            "restoration_id": {
              "type": "string",
              "description": "Restoration ID."
            },
            "state": {
              "type": "string",
              "enum": [
                "open",
                "complete"
              ],
              "description": "open: restricted until reconciliation completes."
            },
            "local_event_cursor": {
              "type": "integer",
              "description": "The agent's event cursor when it opened the restoration."
            },
            "local_execution_seq": {
              "type": "integer",
              "description": "The agent's execution sequence when it opened the restoration."
            },
            "network_event_cursor": {
              "type": "integer",
              "description": "The network's acknowledged event cursor then."
            },
            "network_execution_seq": {
              "type": "integer",
              "description": "The network's execution sequence then."
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "An execution affected by the restore.",
                "properties": {
                  "execution_id": {
                    "type": "string",
                    "description": "Execution ID."
                  },
                  "role": {
                    "type": "string",
                    "description": "provider, requester, or empty for an execution only the agent knows of."
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "network",
                      "local"
                    ],
                    "description": "network: recorded by the network after the local checkpoint; local: pending in the agent's own state."
                  },
                  "resolution": {
                    "type": "string",
                    "description": "How it was resolved: settled_on_network, or the recorded resolution (no_effect, effect_confirmed, repeated_safely, settled_with_counterparty); empty while unresolved."
                  },
                  "resolved": {
                    "type": "boolean",
                    "description": "Whether it is resolved."
                  },
                  "collaboration_id": {
                    "type": "string",
                    "description": "The collaboration the execution ran under, when the network knows it."
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "succeeded",
                      "failed_before_effect",
                      "cancelled",
                      "outcome_unknown"
                    ],
                    "description": "The outcome validated against the network's records (a requester's report backed by a verified receipt); outcome_unknown when they are missing, unresolved or contradictory."
                  },
                  "receipt": {
                    "anyOf": [
                      {
                        "type": "object",
                        "description": "The provider's call receipt."
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The verified receipt behind a validated outcome, for the agent to restore into its local state."
                  },
                  "requester_agent_id": {
                    "type": "string",
                    "description": "The requester of a validated execution, so a provider restores its record under the right caller."
                  }
                },
                "required": [
                  "execution_id",
                  "outcome",
                  "resolution",
                  "resolved"
                ],
                "additionalProperties": false
              },
              "description": "Executions to resolve."
            },
            "unresolved": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Execution ID."
              },
              "description": "Execution IDs still unresolved."
            }
          },
          "required": [
            "restoration_id",
            "state",
            "items",
            "unresolved"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "The agent's open restoration, or null."
    }
  },
  "additionalProperties": false,
  "required": [
    "agent_id",
    "state",
    "config",
    "config_version"
  ],
  "examples": [
    {
      "agent_id": "agt_9cfaed217929",
      "handle": "@invoice-x",
      "state": "active",
      "membership": "provider",
      "config": {
        "autonomy": "service",
        "paused": false
      },
      "config_version": 4,
      "events_acknowledged_through": 1042,
      "executions_recorded_through": 44,
      "restoration": null
    }
  ]
}
