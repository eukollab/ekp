{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/types/service-policy.json",
  "title": "Service policy",
  "description": "How a service handles data, and the terms it is offered under, as declared by the provider's agent in its capability manifest. The network validates the shape and checks the terms document's hash; it shows the declarations to consumers and matches them against consumers' rules, but does not audit them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data",
    "terms"
  ],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "description": "What happens to the inputs a consumer sends.",
      "required": [
        "accepted_data_classes",
        "personal_data_allowed",
        "retention",
        "used_for_training",
        "processing_regions",
        "deletion_on_request",
        "encryption"
      ],
      "properties": {
        "accepted_data_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "personal",
              "special_category"
            ]
          },
          "description": "Classes of data the service accepts. An agreement's data class must be one of them (synthetic counts as public)."
        },
        "personal_data_allowed": {
          "type": "boolean",
          "description": "Whether personal data may be sent. True exactly when personal or special_category is accepted."
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "description": "Whether inputs are kept after the response.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "retained"
              ],
              "description": "none: nothing is kept after the response; retained: inputs are kept for `days`."
            },
            "days": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3650
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "How many days inputs are kept. Required with retained; absent with none."
            }
          }
        },
        "used_for_training": {
          "type": "boolean",
          "description": "Whether inputs or outputs are used to train or improve models."
        },
        "processing_regions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2 country code, e.g. US (EU is reserved, not a country).",
            "not": {
              "const": "EU"
            }
          },
          "description": "Where inputs are processed and stored."
        },
        "subprocessors": {
          "type": "array",
          "maxItems": 30,
          "default": [],
          "description": "Other companies that handle the data for the provider.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "purpose",
              "region"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "The company."
              },
              "purpose": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "What it does with the data."
              },
              "region": {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "description": "ISO 3166-1 alpha-2 country code, e.g. US (EU is reserved, not a country).",
                "not": {
                  "const": "EU"
                }
              }
            }
          }
        },
        "deletion_on_request": {
          "type": "boolean",
          "description": "Whether the provider deletes a consumer's data when asked."
        },
        "encryption": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "in_transit",
            "at_rest"
          ],
          "description": "How the data is protected.",
          "properties": {
            "in_transit": {
              "type": "boolean",
              "description": "Encrypted on the network."
            },
            "at_rest": {
              "type": "boolean",
              "description": "Encrypted where stored."
            }
          }
        },
        "dpa_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://",
              "description": "The provider's data processing agreement. HTTPS."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The provider's data processing agreement. HTTPS."
        }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "description": "The terms the service is offered under. They govern the service between provider and consumer.",
      "required": [
        "terms_url",
        "terms_version",
        "terms_sha256"
      ],
      "properties": {
        "terms_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "The provider's terms document. HTTPS."
        },
        "terms_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "The provider's version label. A change asks portal consumers to accept again."
        },
        "terms_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 (hex) of the exact bytes at terms_url. Validation fetches the document and compares."
        },
        "privacy_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://",
              "description": "The provider's privacy notice. HTTPS."
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The provider's privacy notice. HTTPS."
        },
        "sla": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "availability_pct": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d{1,3}(\\.\\d{1,3})?$"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Monthly availability the provider aims for, in percent."
                },
                "response_p95_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3600000
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "95th percentile response time in milliseconds."
                },
                "support_contact": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Email or URL for support."
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The service level the provider declares."
        },
        "refund_policy": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "The policy in plain words."
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https?://",
                      "description": "Where the full policy is published. HTTPS."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Where the full policy is published. HTTPS."
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the provider refunds."
        },
        "cancellation_policy": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "description": "The policy in plain words."
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https?://",
                      "description": "Where the full policy is published. HTTPS."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Where the full policy is published. HTTPS."
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How a subscription or agreement is cancelled."
        },
        "governing_law": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The law the provider's terms are under, e.g. Delaware, United States."
        }
      }
    }
  },
  "examples": [
    {
      "data": {
        "accepted_data_classes": [
          "public",
          "internal",
          "confidential"
        ],
        "personal_data_allowed": false,
        "retention": {
          "mode": "none"
        },
        "used_for_training": false,
        "processing_regions": [
          "US"
        ],
        "subprocessors": [
          {
            "name": "Example Cloud Inc.",
            "purpose": "hosting",
            "region": "US"
          }
        ],
        "deletion_on_request": true,
        "encryption": {
          "in_transit": true,
          "at_rest": true
        },
        "dpa_url": "https://invoice-x.example/dpa"
      },
      "terms": {
        "terms_url": "https://invoice-x.example/terms",
        "terms_version": "2026-10",
        "terms_sha256": "3f0a3f0a3f0a3f0a3f0a3f0a3f0a3f0a3f0a3f0a3f0a3f0a3f0a3f0a3f0a3f0a",
        "privacy_url": "https://invoice-x.example/privacy",
        "sla": {
          "availability_pct": 99.5,
          "response_p95_ms": 2000,
          "support_contact": "support@invoice-x.example"
        },
        "refund_policy": {
          "summary": "Failed runs are never charged; refunds on request within 14 days."
        },
        "cancellation_policy": {
          "summary": "Subscriptions end at the end of the paid period."
        },
        "governing_law": "Delaware, United States"
      }
    }
  ]
}
