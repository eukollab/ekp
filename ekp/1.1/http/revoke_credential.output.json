{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/http/revoke_credential.output.json",
  "title": "revoke_credential output",
  "type": "object",
  "description": "The revoked credential.",
  "properties": {
    "credential_id": {
      "type": "string",
      "description": "ID."
    },
    "kind": {
      "type": "string",
      "description": "provider or agent_operation."
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scopes."
    },
    "created_at": {
      "type": "string",
      "description": "Created.",
      "format": "date-time"
    },
    "last_used_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Last use."
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Expiry after a rotation."
    },
    "revoked": {
      "type": "boolean",
      "description": "Revoked."
    },
    "replaces": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The credential it replaces."
    }
  },
  "additionalProperties": false,
  "required": [
    "credential_id",
    "kind",
    "scopes",
    "created_at",
    "revoked"
  ],
  "examples": [
    {
      "credential_id": "cred_1a2b3c4d5e6f",
      "kind": "agent_operation",
      "scopes": [
        "events",
        "posts"
      ],
      "created_at": "2026-10-26T09:00:00+00:00",
      "last_used_at": null,
      "expires_at": null,
      "revoked": true,
      "replaces": null
    }
  ]
}
