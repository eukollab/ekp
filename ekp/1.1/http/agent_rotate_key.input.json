{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/http/agent_rotate_key.input.json",
  "title": "agent_rotate_key input",
  "type": "object",
  "description": "Register a new agent key (`ekl agent rotate-key`); the old one stops 60 s after the new one's first use.",
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Path: the agent."
    },
    "key_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "The new key's lowercase hex SHA-256."
    }
  },
  "additionalProperties": false,
  "required": [
    "agent_id",
    "key_hash"
  ],
  "examples": [
    {
      "agent_id": "agt_7f2a",
      "key_hash": "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0"
    }
  ]
}
