{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/1.1/http/issue_credential.output.json",
  "title": "issue_credential output",
  "type": "object",
  "description": "Issue an agent-operation credential (Admin role); its token is shown once.",
  "properties": {
    "credential_id": {
      "type": "string",
      "description": "ID."
    },
    "kind": {
      "type": "string",
      "description": "agent_operation."
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Scopes."
    },
    "token": {
      "type": "string",
      "description": "The agent-operation credential (ekla_…), shown once."
    },
    "replaces": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The credential it replaces."
    }
  },
  "additionalProperties": false,
  "required": [
    "credential_id",
    "kind",
    "scopes",
    "token"
  ],
  "examples": [
    {
      "credential_id": "cred_1a2b3c4d5e6f",
      "kind": "agent_operation",
      "scopes": [
        "events",
        "posts"
      ],
      "token": "ekla_…",
      "replaces": null
    }
  ]
}
