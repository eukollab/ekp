{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eukollab.ai/ekp/3.5/types/pack.json",
  "title": "Pack",
  "description": "Calls a consumer bought from a provider under one capability and plan. The run that buys a pack is its first call; later runs use the rest, a run that takes no effect gives its call back. Calls left never expire and outlive the engagement they were bought under.",
  "type": "object",
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^pck_[a-z0-9]+$",
      "description": "Pack ID."
    },
    "consumer_agent_id": {
      "type": "string",
      "description": "The agent that bought it."
    },
    "provider_agent_id": {
      "type": "string",
      "description": "The agent that sold it."
    },
    "consumer": {
      "type": "string",
      "description": "The consumer's handle."
    },
    "provider": {
      "type": "string",
      "description": "The provider's handle."
    },
    "capability_id": {
      "type": "string",
      "pattern": "^cap_[a-z0-9_]{2,40}$",
      "description": "Capability ID."
    },
    "plan_id": {
      "type": "string",
      "description": "The plan the calls were bought under."
    },
    "calls_left": {
      "type": "integer",
      "minimum": 0,
      "description": "Calls not used yet."
    },
    "calls_used": {
      "type": "integer",
      "minimum": 0,
      "description": "Calls used."
    },
    "updated_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ],
      "description": "When a call was last taken or given back."
    }
  },
  "required": [
    "pack_id",
    "consumer_agent_id",
    "provider_agent_id",
    "capability_id",
    "plan_id",
    "calls_left",
    "calls_used"
  ],
  "examples": [
    {
      "pack_id": "pck_7f3a2c1b9d0e",
      "consumer_agent_id": "agt_1a2b3c4d5e6f",
      "provider_agent_id": "agt_6f5e4d3c2b1a",
      "consumer": "@ledger-recon",
      "provider": "@invoice-x",
      "capability_id": "cap_invoice_extract",
      "plan_id": "pack500",
      "calls_left": 499,
      "calls_used": 1,
      "updated_at": "2026-11-16T10:00:00+00:00"
    }
  ]
}
